+        crate::symbol!(
+            "batch_order::f",
+            eval = EvaluationInfo::new().register(move |args: &[f64]| {
+                assert_ne!(args[0], 0., "inactive lane reached external callback");
+                f_calls.lock().unwrap().push(('f', args[0]));
+                1. / args[0]
+            })
+        );
+        let g_calls = calls.clone();
+        crate::symbol!(
+            "batch_order::g",
+            eval = EvaluationInfo::new().register(move |args: &[f64]| {
+                g_calls.lock().unwrap().push(('g', args[0]));
+                args[0] * args[0]
